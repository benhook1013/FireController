+
+// Identity qualification uses the same bound provider as ordinary CI reads.
+func (r *hostedArchiveSource) SupportsCIIdentityQualification() bool {
+	_, ok := r.provider.(interface {
+		QualifyCIIdentityPair(context.Context, int64, string, [2]int64) (reviewprovider.CIIdentityPairQualification, error)
+	})
+	return ok
+}
+func (r *hostedArchiveSource) QualifyCIIdentityPair(ctx context.Context, id int64, repository string, numbers [2]int64) (reviewprovider.CIIdentityPairQualification, error) {
+	if reader, ok := r.provider.(interface {
+		QualifyCIIdentityPair(context.Context, int64, string, [2]int64) (reviewprovider.CIIdentityPairQualification, error)
+	}); ok {
+		return reader.QualifyCIIdentityPair(ctx, id, repository, numbers)
+	}
+	return reviewprovider.CIIdentityPairQualification{State: "refused"}, reviewprovider.ErrCombinedPullUnsupported
+}
diff --git a/internal/reviewexec/lifecycle_identity_qualification.go b/internal/reviewexec/lifecycle_identity_qualification.go
new file mode 100644
index 00000000..de8ef778
--- /dev/null
+++ b/internal/reviewexec/lifecycle_identity_qualification.go
@@ -0,0 +1,49 @@
+package reviewexec
+
+import (
+	"context"
+	"github.com/benhook1013/FireController/internal/reviewprovider"
+	"log/slog"
+)
+
+type ciIdentityQualifier interface {
+	QualifyCIIdentityPair(context.Context, int64, string, [2]int64) (reviewprovider.CIIdentityPairQualification, error)
+}
+
+// Called only after natural-cohort admission/binding/preparation. The outer
+// cohort retains its reservation; diagnostics never replace prepared evidence.
+func qualifyLifecycleCIIdentity(ctx context.Context, s *lifecycleSchedule, targets []lifecycleTarget) bool {
+	if !s.options.QualifyCIIdentityPair || len(targets) != 2 || lifecycleCohortHasSubscribers(s, targets) {
+		return true
+	}
+	first := targets[0]
+	q, ok := first.reader.(ciIdentityQualifier)
+	if !ok {
+		return true
+	}
+	if support, known := first.reader.(interface{ SupportsCIIdentityQualification() bool }); known && !support.SupportsCIIdentityQualification() {
+		return true
+	}
+	if !first.cohortOwned || !targets[1].cohortOwned {
+		return true
+	}
+	s.mu.Lock()
+	if s.identityQualificationClaimed == nil {
+		s.identityQualificationClaimed = map[string]bool{}
+	}
+	if s.identityQualificationClaimed[first.account] || s.options.Now().Before(s.accounts[first.account].until) {
+		s.mu.Unlock()
+		return true
+	}
+	s.identityQualificationClaimed[first.account] = true
+	s.mu.Unlock()
+	result, err := q.QualifyCIIdentityPair(reviewprovider.WithGitHubCaller(ctx, "lifecycle_enrichment_periodic"), first.repository, first.repositoryName, [2]int64{first.number, targets[1].number})
+	slog.Info("ci_identity_qualification", "bucket", result.Bucket, "state", result.State, "transport_calls", result.Requests)
+	if err != nil {
+		s.mu.Lock()
+		s.finishAccountLocked(first, err, s.options.Now())
+		s.mu.Unlock()
+		return false
+	}
+	return ctx.Err() == nil
+}
diff --git a/internal/reviewexec/lifecycle_identity_qualification_test.go b/internal/reviewexec/lifecycle_identity_qualification_test.go
new file mode 100644
index 00000000..5ee53750
--- /dev/null
+++ b/internal/reviewexec/lifecycle_identity_qualification_test.go
@@ -0,0 +1,65 @@
+package reviewexec
+
+import (
+	"context"
+	"github.com/benhook1013/FireController/internal/reviewprovider"
+	"testing"
+)
+
+type identityQualificationReader struct {
+	*sourceCITestReader
+	calls int
+	err   error
+	hook  func()
+}
+
+func (r *identityQualificationReader) QualifyCIIdentityPair(context.Context, int64, string, [2]int64) (reviewprovider.CIIdentityPairQualification, error) {
+	r.calls++
+	if r.hook != nil {
+		r.hook()
+	}
+	return reviewprovider.CIIdentityPairQualification{State: "matched", Requests: 5}, r.err
+}
+func TestLifecycleCIIdentityQualificationReservation(t *testing.T) {
+	for _, mode := range []string{"matched", "disabled", "limit", "watch", "unowned"} {
+		t.Run(mode, func(t *testing.T) {
+			_, s, clock := lifecycleFixture(t)
+			s.options.QualifyCIIdentityPair = mode != "disabled"
+			r := &identityQualificationReader{sourceCITestReader: &sourceCITestReader{}}
+			if mode == "limit" {
+				r.err = &reviewprovider.Error{Code: "provider_rate_limited", RetryAfterSeconds: 17}
+			}
+			first := lifecycleTarget{reader: r, project: attemptProject, account: "fixture", lane: lifecycleEnrichment, number: 2, repository: 801, repositoryName: "owner/repo", cohortOwned: mode != "unowned"}
+			second := first
+			second.number = 4
+			s.lanes[lifecycleEnrichment].projects[first.project] = true
+			s.lanes[lifecycleEnrichment].accounts[first.account] = true
+			if mode == "watch" {
+				s.watches = map[ciWatchKey]*ciWatchEntry{{binding: ciWatchBinding{project: first.project}, number: 2}: {owners: map[*ciWatchSubscription]bool{&ciWatchSubscription{}: true}}}
+			}
+			r.hook = func() {
+				if !s.lanes[lifecycleEnrichment].accounts[first.account] {
+					t.Fatal("reservation lost during read")
+				}
+			}
+			ok := qualifyLifecycleCIIdentity(t.Context(), s, []lifecycleTarget{first, second})
+			want := 1
+			if mode == "disabled" || mode == "watch" || mode == "unowned" {
+				want = 0
+			}
+			if r.calls != want || ok == (mode == "limit") {
+				t.Fatal(r.calls, ok)
+			}
+			if !s.lanes[lifecycleEnrichment].accounts[first.account] {
+				t.Fatal("probe released outer reservation")
+			}
+			if mode == "limit" && !s.accounts[first.account].until.After(clock.Now()) {
+				t.Fatal("cooldown missing")
+			}
+			qualifyLifecycleCIIdentity(t.Context(), s, []lifecycleTarget{first, second})
+			if r.calls != want {
+				t.Fatal("probe repeated")
+			}
+		})
+	}
+}
