--- /dev/null
+++ b/internal/reviewexec/run_selection_settlement_timing_test.go
@@ -0,0 +1,56 @@
+package reviewexec
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/benhook1013/FireController/internal/core"
+	"log/slog"
+	"testing"
+	"time"
+)
+
+func TestSelectionSettlementTimingPartitionsAttempts(t *testing.T) {
+	base := time.Unix(100, 0)
+	at := func(ms int) time.Time { return base.Add(time.Duration(ms) * time.Millisecond) }
+	s := selectionSettlementTiming{started: base}
+	s.attempt(at(0), time.Time{}, time.Time{}, at(2000), fmt.Errorf("wrapped: %w", core.Fail("overloaded", "private", 503)))
+	s.attempt(at(2100), at(2400), at(2800), at(3000), nil)
+	if s.attempts != 2 || s.entered != 1 || s.overloaded != 1 || s.attemptTime != 2900*time.Millisecond || s.beforeCallback != 2300*time.Millisecond || s.callbackTime != 400*time.Millisecond || s.afterCallback != 200*time.Millisecond {
+		t.Fatalf("bad accounting: %+v", s)
+	}
+	if s.beforeCallback+s.callbackTime+s.afterCallback != s.attemptTime {
+		t.Fatal("phase totals differ")
+	}
+}
+
+func TestSelectionSettlementTimingQuietThresholdAndSafeFields(t *testing.T) {
+	var out bytes.Buffer
+	old := slog.Default()
+	slog.SetDefault(slog.New(slog.NewJSONHandler(&out, nil)))
+	defer slog.SetDefault(old)
+	base := time.Unix(100, 0)
+	s := selectionSettlementTiming{started: base}
+	r := Run{ProjectID: "project", ID: "selection", Channel: "cli"}
+	s.log(context.Background(), r, base.Add(10*time.Second-time.Nanosecond))
+	if out.Len() != 0 {
+		t.Fatal("ordinary settlement logged")
+	}
+	s.log(context.Background(), r, base.Add(10*time.Second))
+	var got map[string]any
+	if err := json.Unmarshal(out.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	for _, key := range []string{"duration_ms", "write_attempts", "callbacks_entered", "overloaded_attempts", "before_callback_ms", "callback_ms", "after_callback_ms", "outside_write_ms"} {
+		if _, ok := got[key]; !ok {
+			t.Fatalf("missing %s", key)
+		}
+	}
+	if got["duration_ms"] != float64(10000) || got["outside_write_ms"] != float64(10000) {
+		t.Fatal(got)
+	}
+	if len(got) != 14 {
+		t.Fatalf("unexpected diagnostic fields: %v", got)
+	}
+}
