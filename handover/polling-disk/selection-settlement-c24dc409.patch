+++ b/internal/reviewexec/run_selection_settlement_timing.go
@@ -0,0 +1,46 @@
+package reviewexec
+
+import (
+	"context"
+	"errors"
+	"github.com/benhook1013/FireController/internal/core"
+	"log/slog"
+	"time"
+)
+
+// Fixed local diagnostics. Before-callback includes admission and BeginTx;
+// after-callback includes commit/rollback and notifications, not only SQL locks.
+// Outside-write includes retry pauses and final history/notification work.
+// No provider facts, SQL statements or arbitrary errors are logged.
+type selectionSettlementTiming struct {
+	started                                                  time.Time
+	attempts, entered, overloaded                            int
+	attemptTime, beforeCallback, callbackTime, afterCallback time.Duration
+}
+
+func (t *selectionSettlementTiming) attempt(start, entered, exited, end time.Time, err error) {
+	t.attempts++
+	t.attemptTime += end.Sub(start)
+	var failure *core.Error
+	if errors.As(err, &failure) && failure.Code == "overloaded" {
+		t.overloaded++
+	}
+	if entered.IsZero() {
+		t.beforeCallback += end.Sub(start)
+		return
+	}
+	t.entered++
+	t.beforeCallback += entered.Sub(start)
+	t.callbackTime += exited.Sub(entered)
+	t.afterCallback += end.Sub(exited)
+}
+func (t *selectionSettlementTiming) log(ctx context.Context, r Run, end time.Time) {
+	total := end.Sub(t.started)
+	if total < 10*time.Second {
+		return
+	}
+	slog.WarnContext(ctx, "Review selection settlement was slow", "project_id", r.ProjectID, "selection_id", r.ID, "channel", r.Channel,
+		"duration_ms", total.Milliseconds(), "write_attempts", t.attempts, "callbacks_entered", t.entered, "overloaded_attempts", t.overloaded,
+		"before_callback_ms", t.beforeCallback.Milliseconds(), "callback_ms", t.callbackTime.Milliseconds(), "after_callback_ms", t.afterCallback.Milliseconds(),
+		"outside_write_ms", max(int64(0), (total-t.attemptTime).Milliseconds()))
+}
diff --git a/internal/reviewexec/run_selection_settlement_timing_test.go b/internal/reviewexec/run_selection_settlement_timing_test.go
new file mode 100644
