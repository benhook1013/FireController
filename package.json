{
  "name": "firecontroller-docs-validation",
  "private": true,
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "docs:check": "markdownlint-cli2 \"**/*.md\" \"!**/.git/**\" \"!**/.local/**\" \"!**/bin/**\" \"!**/dist/**\" \"!**/node_modules/**\" && node --test tools/check-doc-links.test.mjs && node tools/check-doc-links.mjs"
  },
  "devDependencies": {
    "github-slugger": "2.0.0",
    "markdownlint-cli2": "0.23.3",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
  }
}
